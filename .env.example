# ==============================================================
# Rentify - Full-Stack Property Rental Marketplace
# Environment Variables Example Configuration
# ==============================================================

# --- Backend Configuration (server/.env) ---
PORT=5000

# MongoDB Atlas Free Tier connection string or local MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rentify?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Cloudinary (Free image hosting)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# AI Semantic Search & RAG (Google Gemini Free Tier)
# Obtain free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Optional: Alternative OpenAI provider
# OPENAI_API_KEY=your_openai_api_key_here

# --- Frontend Configuration (client/.env) ---
VITE_API_URL=http://localhost:5000/api
