# Server Environment Configuration
PORT=5000

# MongoDB Connection String (Atlas free-tier M0 or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rentify?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Cloudinary Storage Configuration (Free tier for property image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# AI & Semantic Search Configuration (Google Gemini Free-Tier or OpenAI)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if using OpenAI instead of Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
